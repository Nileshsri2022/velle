<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenNotch</AssemblyName>
    <RootNamespace>OpenNotch</RootNamespace>
    <Description>OpenNotch - an original, open-source notch for Windows. Free forever: no trial, no account, no network in v1.</Description>
    <Authors>OpenNotch contributors</Authors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenNotch.Core\OpenNotch.Core.csproj" />
  </ItemGroup>
</Project>
