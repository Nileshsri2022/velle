<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenInstaller</AssemblyName>
    <RootNamespace>OpenInstaller</RootNamespace>
    <Description>OpenInstaller - an original, open-source Windows installer helper built on the public winget CLI.</Description>
    <Authors>OpenInstaller contributors</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenInstaller.Core\OpenInstaller.Core.csproj" />
  </ItemGroup>
</Project>
